APP_NAME="Doogsan Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Language editions — the root domain redirects to the visitor's preferred
# edition (Accept-Language / saved choice) or this default.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
DOOGSAN_DEFAULT_EDITION=en
# Editorial/local display timezone. Timestamps are stored in UTC.
DOOGSAN_TIMEZONE=Africa/Mogadishu
DOOGSAN_CONTACT_EMAIL=info@doogsanmedia.com
# Require TOTP two-factor for privileged roles (recommended: true in production)
DOOGSAN_ENFORCE_2FA=false
# Seconds between fallback polls when the real-time socket is unavailable
DOOGSAN_POLL_INTERVAL=45

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: mysql or mariadb. Local quick-start: sqlite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=doogsan
# DB_USERNAME=doogsan
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Real-time: reverb (self-hosted WebSocket server) or log/null to disable.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
# Production: redis. Local: database.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@doogsanmedia.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=doogsan
REVERB_APP_KEY=change-me-public-key
REVERB_APP_SECRET=change-me-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Optional integrations (also editable in Admin → Settings where noted)
GOOGLE_ANALYTICS_ID=
